---
const { name, role, quote } = Astro.props;
---

<div class="testimonial bg-white border border-gray-100 px-8 py-10 tracking-wide leading-relaxed">

    <div class="mb-4">
        <h3 class="text-2xl font-bold">
            {name}
        </h3>
        <p class="text-lg font-normal mt-3">
            {role}
        </p>
    </div>

    <p class="text-base italic font-normal">
        {quote}
    </p>
</div>

<style>
    .testimonial {
        color: var(--color-brand-blue);
        background-color: var(--color-brand-white);
        min-height: fit-content;
        box-shadow: 0 4px 6px 0 hsla(0, 0%, 0%, 0.2);
    }

</style>