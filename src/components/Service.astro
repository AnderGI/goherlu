---
interface Props {
    title: string;
    features: string[];
}

const {title, features} = Astro.props;

---
<div class="bg-[var(--color-bg-white)] p-8 shadow-xl text-[var(--color-text-main)] flex flex-col justify-between max-w-md border-t-4 border-[var(--color-accent-yellow)]">
    <!-- Card Header & Description -->
    <div>
        <h3 class="
            text-3xl
            font-bold text-[var(--color-brand-blue)] mb-3 leading-snug">{title}</h3>

        <!-- Included Features / Services List (No Icons/SVGs) -->
        <div class="
        pt-5 border-t border-[var(--color-bg-gray)]">
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-brand-blue)]/60 mb-4">
                Lo que incluye:
            </p>

            <ul class="space-y-3">
                {features.map((feature, i) => (
                        <li class="flex items-start gap-3 text-sm text-[var(--color-brand-blue)]/90 leading-snug">
                            <span>{feature}</span>
                        </li>
                ))}
            </ul>
        </div>
    </div>
</div>