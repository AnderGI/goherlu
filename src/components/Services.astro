---
import Service from "./Service.astro";
---
<section class="
   grid relative z-3 -mt-30 pb-50
    grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4
    grid-rows-4 md:grid-rows-2 lg:grid-rows-2 xl:grid-rows-1
    gap-4 xl:gap-6 2xl:gap-12
    px-4 xl:px-28 2xl:px-64
    md:pb-50 mt-20 md:mt-30">
    <Service
            title="Instalaciones eléctricas completas"
            features={[
                "Estudio personalizado de necesidades",
                "Diseño optimizado y eficiente",
                "Cumplimiento estricto normativa REBT",
                "Materiales certificados de primera calidad",
                "Garantía de 2 años en mano de obra",
                "Certificación y legalización incluida"
            ]}
    />
    <Service
            title="Reformas eléctricas"
            features={[
                "Diagnóstico completo del estado actual",
                "Mejora significativa de eficiencia energética",
                "Adaptación a nuevos electrodomésticos",
                "Sustitución de componentes obsoletos",
                "Actualización a normativa vigente",
                "Certificación oficial tras reforma"
            ]}
    />
    <Service
            title="Instalaciones en obra nueva"
            features={[
                "Planificación desde fase de proyecto",
                "Coordinación con arquitectos y constructores",
                "Integración de sistemas domóticos",
                "Optimización de recursos y costes",
                "Supervisión continua de obra",
                "Entrega con certificación completa"
            ]}
    />
    <Service
            title="Reparación de averías eléctricas"
            features={[
                "Disponibilidad 24 horas, 7 días",
                "Tiempo de respuesta inferior a 2 horas",
                "Diagnóstico preciso con equipos avanzados",
                "Reparación inmediata en la mayoría de casos",
                "Presupuesto transparente sin sorpresas",
                "Garantía en todas las reparaciones"
            ]}
    />
    <Service
            title="Mantenimiento preventivo"
            features={[
                "Inspecciones programadas según necesidades",
                "Detección temprana de problemas potenciales",
                "Prolongación de vida útil de instalaciones",
                "Informes detallados tras cada revisión",
                "Planes personalizados para empresas",
                "Reducción de costes por averías imprevistas"
            ]}
    />
    <Service
            title="Iluminación LED y eficiencia"
            features={[
                "Ahorro de hasta 80% en consumo",
                "Estudio lumínico personalizado",
                "Iluminación decorativa y funcional",
                "Mayor durabilidad que sistemas tradicionales",
                "Regulación y control inteligente",
                "Amortización en menos de 2 años"
            ]}
    />
    <Service
            title="Instalaciones de telecomunicaciones"
            features={[
                "Diseño de redes de datos eficientes",
                "Instalación de fibra óptica",
                "Cableado categoría 6 y superior",
                "Certificación de instalaciones",
                "Integración con sistemas existentes",
                "Soporte técnico continuado"
            ]}
    />
    <Service
            title="Boletines y certificaciones"
            features={[
                "Certificados de instalación eléctrica",
                "Boletines de baja tensión",
                "Inspecciones técnicas oficiales",
                "Tramitación con distribuidoras",
                "Asesoramiento normativo completo",
                "Gestión integral de documentación"
            ]}
    />
</section>